# DataLens
DATALENS_BASE_URL=http://localhost:8085
DATALENS_AUTH_URL=http://127.0.0.1:8088
DATALENS_USERNAME=admin
DATALENS_PASSWORD=admin
DATALENS_WORKBOOK_TITLE="AI Generated"
# United Storage dev endpoint for dashboard entry locks.
DATALENS_US_URL=http://localhost:3030
DATALENS_TIMEOUT=60

# Only Laravel admin at these origins may open API/SSE requests.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Connection type accepted by DataLens. AI schema analysis currently supports
# PostgreSQL only, therefore keep `postgres` until another analyzer is added.
DATALENS_DB_TYPE=postgres

# Адрес базы, который видит DataLens из Docker.
DATALENS_DB_HOST=172.17.0.1
DATALENS_DB_PORT=5432
DATALENS_DB_NAME=21_lms
DATALENS_DB_USER=wren_user
DATALENS_DB_PASSWORD=wren_password

# Адрес базы, который видит сам AI-сервис на хосте.
DB_URL=postgresql://wren_user:wren_password@127.0.0.1:5432/21_lms

# Official OpenAI API. Put the real key only in your local .env, never in Git.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT=180
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_REASONING_EFFORT=low

