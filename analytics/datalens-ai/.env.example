# DataLens
#
# ── Host mode (default below) ────────────────────────────────────────────────
# datalens-ai runs on the host (uvicorn/venv), DataLens in Docker.
#
# ── Docker mode ─────────────────────────────────────────────────────────────
# When started via the ROOT docker-compose.yml, the following keys are
# overridden automatically with in-network service names, so you do NOT have
# to change them here:
#   DATALENS_BASE_URL=http://ui:8080
#   DATALENS_AUTH_URL=http://auth:8080
#   DATALENS_US_URL=http://us:8080
#   DATALENS_DB_HOST=db
#   DB_URL=postgresql://<DB_USERNAME>:<DB_PASSWORD>@db:5432/<DB_DATABASE>
#   SERVICE_API_KEY=<from root .env: DATALENS_AI_API_KEY>
#   CORS_ORIGINS=<nginx origin, e.g. http://localhost>
DATALENS_BASE_URL=http://localhost:8085
DATALENS_AUTH_URL=http://127.0.0.1:8088
DATALENS_USERNAME=admin
DATALENS_PASSWORD=admin
DATALENS_WORKBOOK_TITLE="AI Generated"
# United Storage dev endpoint for dashboard entry locks.
DATALENS_US_URL=http://localhost:3030
DATALENS_TIMEOUT=60

# Only Laravel admin at these origins may open API/SSE requests.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Connection type accepted by DataLens. AI schema analysis currently supports
# PostgreSQL only, therefore keep `postgres` until another analyzer is added.
DATALENS_DB_TYPE=postgres

# Адрес базы, который видит DataLens из Docker.
DATALENS_DB_HOST=172.17.0.1
DATALENS_DB_PORT=5432
DATALENS_DB_NAME=21_lms
DATALENS_DB_USER=wren_user
DATALENS_DB_PASSWORD=wren_password

# Адрес базы, который видит сам AI-сервис на хосте.
DB_URL=postgresql://wren_user:wren_password@127.0.0.1:5432/21_lms

# Shared secret: Laravel sends this in X-API-Key header; datalens-ai validates it.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Leave empty to disable auth check (local development only).
SERVICE_API_KEY=

# === LLM: universal provider settings (preferred over legacy OPENAI_*) ===
# LLM_PROVIDER — API family:
#   openai     — OpenAI and ANY OpenAI-compatible endpoint (GLM/Zhipu, Z.ai,
#                OpenRouter, DeepSeek, Ollama, vLLM, LM Studio, ...) via LLM_BASE_URL
#   anthropic  — Claude Messages API
#   google     — Gemini generateContent
#
# Provider examples (LLM_PROVIDER / LLM_BASE_URL / LLM_MODEL):
#   OpenAI:      openai     | (empty)                            | gpt-5.6-luna
#   GLM Zhipu:   openai     | https://open.bigmodel.cn/api/paas/v4 | glm-5.3-flash
#   GLM Z.ai:    openai     | https://api.z.ai/api/paas/v4       | glm-5.3-flash
#   OpenRouter:  openai     | https://openrouter.ai/api/v1       | anthropic/claude-sonnet-4.6
#   DeepSeek:    openai     | https://api.deepseek.com/v1        | deepseek-chat
#   Ollama:      openai     | http://127.0.0.1:11434/v1          | qwen3:14b (no key needed)
#   Claude:      anthropic  | (empty)                            | claude-sonnet-4-6
#   Gemini:      google     | (empty)                            | gemini-2.5-flash
LLM_PROVIDER=openai
# API key of the chosen provider. May stay empty for self-hosted
# OpenAI-compatible servers (Ollama, vLLM) that do not require auth.
LLM_API_KEY=
# Base URL of the LLM API. Empty = official endpoint of the provider.
LLM_BASE_URL=
# Model name. Empty = per-provider default (see config.LLM_PROVIDER_DEFAULTS).
LLM_MODEL=
LLM_TIMEOUT=180
LLM_MAX_OUTPUT_TOKENS=4096
# Reasoning effort for OpenAI-family reasoning models: minimal|low|medium|high.
# Empty = omit the parameter (keep empty for GLM/anthropic/google).
LLM_REASONING_EFFORT=
# Optional escape hatch: raw JSON merged verbatim into every OpenAI-family
# request body (core fields always win). Use it for provider-native switches:
#   GLM/Z.ai: {"thinking":{"type":"disabled"}}   Qwen3: {"enable_thinking":false}
LLM_EXTRA_BODY=

# --- Legacy OpenAI block: still read as fallback when LLM_* is empty. ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.6-luna

