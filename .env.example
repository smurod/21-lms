# =============================================================================
# 21 LMS — environment template
#
#   cp .env.example .env
#   make key        # (or: docker compose run --rm app php artisan key:generate)
#   make up
#
# This single file configures the WHOLE stack: Laravel, PostgreSQL, Redis,
# datalens-ai and the DataLens OSS services included from
# analytics/datalens/docker-compose.yaml.
#
# Inside docker-compose some host-oriented values (DB_HOST, REDIS_HOST,
# DATALENS_AI_URL) are overridden per service — see the `environment:` blocks
# in docker-compose.yml.
# =============================================================================

# ------------------------------------------------------------------ Laravel
APP_NAME="21 LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# -------------------------------------------------------- published ports
# Host ports. Change if they collide with other services on the machine.
APP_PORT=80
DB_PORT=5432
REDIS_PORT=6379
AI_PORT=8100
# DataLens UI port (consumed by the included DataLens compose)
UI_PORT=8085

# ------------------------------------------------------------- PostgreSQL
DB_CONNECTION=pgsql
# On the host: 127.0.0.1. Inside docker-compose it is overridden to `db`.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=21_lms
DB_USERNAME=lms_user
# CHANGE THIS in any real deployment
DB_PASSWORD=change-me-strong

# ------------------------------------------------------------------- Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# --------------------------------------------- sessions / cache / queues
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

# ------------------------------------------------------------------- Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------- Seeders
# Default password for seeded accounts (admin@gmail.com, test@…)
SEED_PASSWORD=school21
SEED_DEMO_USERS=false
SEED_AUTOTEST_WORKFLOW=false

# ------------------------------------------------------- container boot
# entrypoint.sh flags
MIGRATE_ON_BOOT=true
CACHE_ON_BOOT=true

# ----------------------------------------------------------------- GitLab
GITLAB_URL=http://localhost
GITLAB_TOKEN=
GITLAB_ADMIN_TOKEN=
GITLAB_VISIBILITY=public
GITLAB_CACHE_TTL=300

# ------------------------------------------------------------- datalens-ai
# Server-side address of the FastAPI service.
#   host mode:  http://127.0.0.1:8100
#   docker:     overridden to http://datalens-ai:8100 in docker-compose.yml
DATALENS_AI_URL=http://127.0.0.1:8100
# Address the BROWSER opens SSE streams on (admin panel). Empty = same as
# DATALENS_AI_URL. In docker-compose it is set to http://localhost:${AI_PORT}.
DATALENS_AI_PUBLIC_URL=
DATALENS_AI_TIMEOUT=120
# Dashboard links shown to users
DATALENS_UI_URL=http://localhost:8085
# Shared secret (X-API-Key) between Laravel and datalens-ai.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must match SERVICE_API_KEY used by the datalens-ai container.
DATALENS_AI_API_KEY=

# =======================================================================
# DataLens OSS stack (analytics/datalens/docker-compose.yaml reads these)
# =======================================================================
POSTGRES_USER=pg-user
POSTGRES_PASSWORD=postgres
POSTGRES_DB_US=pg-us-db

# Dev-friendly defaults of this deployment: DataLens auth is disabled and
# the AI service logs in with admin/admin against the auth service.
AUTH_ENABLED=false
AUTH_TYPE=NONE
TEMPORAL_AUTH_ENABLED=false
EXPORT_WORKBOOK_ENABLED=0
AUTH_ADMIN_PASSWORD=admin

# Re-pull DataLens images on every `up`? `missing` = pull only once.
IMAGE_PULL_POLICY=missing

VITE_APP_NAME="${APP_NAME}"
